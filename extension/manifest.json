{
  "manifest_version": 2,
  "name": "SearchTrail",
  "version": "0.3.3",
  "description": "Return to your source page; open the menu for browsing trails, bookmarks and local history. Blocks pop-up tabs.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "SearchTrail",
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "styles.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
